{
  "name": "michalsalek-com",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "npm run generate:visuals && next dev --hostname 0.0.0.0",
    "build": "npm run generate:visuals && next build --webpack && next-image-export-optimizer && node scripts/generate-site-files.mjs",
    "generate:visuals": "node scripts/generate-service-visuals.mjs",
    "preview": "serve out --listen 3100",
    "start": "npm run preview",
    "typecheck": "next typegen && node node_modules/@typescript/native/bin/tsc --noEmit",
    "type-check": "npm run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test",
    "check": "npm run verify && npm run build && npm run audit:export",
    "audit:export": "node scripts/audit-export.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "deploy": "bash scripts/deploy/deploy.sh",
    "deploy:dry": "bash scripts/deploy/deploy.sh --dry-run",
    "deploy:rollback": "bash scripts/deploy/rollback.sh",
    "verify:live": "node scripts/verify-live.mjs",
    "preview:test": "serve out --listen 4318",
    "prepare": "node scripts/setup-hooks.mjs",
    "hooks:install": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@emotion/cache": "11.14.0",
    "@emotion/server": "11.11.0",
    "@mui/material-nextjs": "9.5.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "next-image-export-optimizer": "1.21.2",
    "sass": "1.107.0",
    "typescript": "npm:@typescript/typescript6@6.0.3",
    "@playwright/test": "1.64.1",
    "cheerio": "1.2.0",
    "serve": "14.2.6",
    "lighthouse": "13.6.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "sharp": "0.35.5"
  },
  "overrides": {
    "serve": {
      "compression": "1.8.2"
    }
  }
}
