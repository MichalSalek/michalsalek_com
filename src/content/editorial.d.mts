import type {Locale, PagePath} from './site.mjs';
import type {VisualAsset} from './visuals.mjs';
import type {DiagramIcon} from './explanation-plans.mjs';
export type LocalText = Record<Locale, string>;
export type EditorialOpening = 'essay' | 'split' | 'panorama' | 'compact' | 'feature';
export type EditorialLayout = 'prose' | 'aside' | 'split' | 'sequence' | 'ledger' | 'decisions' | 'feature' | 'reference';
export type EditorialReference = 'glossary' | 'notes' | 'table' | 'inline';
export type EditorialExhibitKind = 'review' | 'records' | 'states' | 'lineage' | 'permissions' | 'layers' | 'history' | 'delivery' | 'terrain' | 'mix' | 'score' | 'publication';
export type EditorialExhibitPlan = {kind: EditorialExhibitKind; icons?: DiagramIcon[]; title: LocalText; caption: LocalText; items: {label: LocalText; detail: LocalText}[]};
export type EditorialTake = {section: number; paragraphs?: 'all' | number[]; items?: 'all' | number[]; facts?: 'all' | number[]};
export type EditorialChapterPlan = {id: string; title?: LocalText; layout: EditorialLayout; take: EditorialTake[]; note?: LocalText; exhibit?: EditorialExhibitPlan; exhibitPosition?: 'before' | 'after' | 'aside'; reference?: EditorialReference};
export type EditorialPlan = {opening: EditorialOpening; cover: 'opening' | string; toc: 'none' | 'inline' | 'rail'; reference: EditorialReference; roleAt?: 'opening' | string; chapters: EditorialChapterPlan[]};
export type EditorialMedia = {variant: 'wide' | 'inline'; asset: VisualAsset};
export type EditorialSourceSection = {id?: string; title: string; subtitle?: string; paragraphs: string[]; items?: {title: string; description: string}[]; facts?: {term: string; detail: string}[]; media?: {after: number; variant: 'wide' | 'inline'; asset: VisualAsset}[]};
export type EditorialExhibit = {kind: EditorialExhibitKind; icons?: DiagramIcon[]; title: string; caption: string; items: {label: string; detail: string}[]};
export type EditorialParagraph = {key: string; text: string; media: EditorialMedia[]};
export type EditorialChapter = {id: string; title: string; layout: EditorialLayout; paragraphs: EditorialParagraph[]; items: {title: string; description: string}[]; facts: {term: string; detail: string}[]; anchors: string[]; note?: string; exhibit?: EditorialExhibit; exhibitPosition: 'before' | 'after' | 'aside'; reference: EditorialReference};
export type EditorialLink = {path: PagePath; title: string};
export type EditorialDocument = {kind: 'service' | 'project'; opening: EditorialOpening; cover: string; toc: 'none' | 'inline' | 'rail'; reference: EditorialReference; roleAt: string; intro: string[]; audience: string; role: string; category: string; projectId: string; stack: {term: string; detail: string}[]; chapters: EditorialChapter[]; related: EditorialLink[]; previous: EditorialLink | null; next: EditorialLink | null};
export const editorialPlans: Record<string, EditorialPlan>;
export const editorialPaths: PagePath[];
export function compileEditorial(input: {locale: Locale; path: PagePath; sections: EditorialSourceSection[]; intro?: string[]; audience?: string; role?: string; category?: string; projectId?: string; stack?: {term: string; detail: string}[]; related?: EditorialLink[]; previous?: EditorialLink | null; next?: EditorialLink | null}): EditorialDocument | null;
export function compileWithPlan(plan: EditorialPlan, input: Parameters<typeof compileEditorial>[0]): EditorialDocument;
export function compositionSignature(plan: EditorialPlan): string;
